---
import type { Translations } from '../i18n/translations';

interface Props {
  tr: Translations;
  lang: string;
}

const { tr, lang } = Astro.props;

const services = [
  {
    key: 'miniEu',
    data: tr.services.miniEu,
    icon: '/Cards SVG/Mini-eu.svg',
  },
  {
    key: 'laser',
    data: tr.services.laser,
    icon: '/Cards SVG/Gravação Laser.svg',
  },
  {
    key: 'tabletop',
    data: tr.services.tabletop,
    icon: '/Cards SVG/Tabletop.svg',
  },
  {
    key: 'collectibles',
    data: tr.services.collectibles,
    icon: '/Cards SVG/Colecionáveis.svg',
  },
  {
    key: 'cosplay',
    data: tr.services.cosplay,
    icon: '/Cards SVG/Cosplay.svg',
  },
  {
    key: 'custom',
    data: tr.services.custom,
    icon: '/Cards SVG/Customizáveis.svg',
  },
];

const ctaLabel = tr.services.cta;
---

<section class="section services" aria-labelledby="services-heading">
  <div class="container">

    <header class="services-header">
      <p class="label" id="services-heading">{tr.services.heading}</p>
      <h2 class="section-title">{tr.services.subheading}</h2>
    </header>

    <div class="carousel" role="region" aria-label={tr.services.heading}>

      <button class="carousel-arrow carousel-prev" aria-label="Anterior" id="svc-prev">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 4l-6 6 6 6"/>
        </svg>
      </button>

      <div class="carousel-viewport">
        <ul class="carousel-track" id="svc-track">
          {services.map((service, i) => (
            <li class={`carousel-slide${i === 0 ? ' is-active' : ''}`} data-index={i} data-key={service.key}>
              <article class="service-card">
                <span class="card-number">{String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}</span>
                <h3 class="service-name">{service.data.label}</h3>
                <p class="service-desc">{service.data.description}</p>
                <span class="service-icon" style={`background-image: url('${service.icon}')`} aria-hidden="true"></span>
                <a
                  class="cta-btn"
                  href={`/${lang}/portfolio?filter=${service.key}`}
                  tabindex={i === 0 ? '0' : '-1'}
                >{ctaLabel}</a>
              </article>
            </li>
          ))}
        </ul>
      </div>

      <button class="carousel-arrow carousel-next" aria-label="Próximo" id="svc-next">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 4l6 6-6 6"/>
        </svg>
      </button>

    </div>

    <div class="carousel-dots" id="svc-dots" aria-hidden="true">
      {services.map((_, i) => (
        <button class={`dot${i === 0 ? ' is-active' : ''}`} data-dot={i} tabindex="-1" />
      ))}
    </div>

  </div>
</section>

<script>
  const track   = document.getElementById('svc-track') as HTMLElement;
  const dotsEl  = document.getElementById('svc-dots') as HTMLElement;
  const prevBtn = document.getElementById('svc-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('svc-next') as HTMLButtonElement;
  const GAP = 24;

  // ── Infinite loop: clone first 2 and last 2 slides ──
  const realSlides = Array.from(track.querySelectorAll<HTMLElement>('.carousel-slide'));
  const total = realSlides.length;

  // prepend clones of last 2
  const cloneStart1 = realSlides[total - 2].cloneNode(true) as HTMLElement;
  const cloneStart2 = realSlides[total - 1].cloneNode(true) as HTMLElement;
  // append clones of first 2
  const cloneEnd1 = realSlides[0].cloneNode(true) as HTMLElement;
  const cloneEnd2 = realSlides[1].cloneNode(true) as HTMLElement;

  [cloneStart2, cloneStart1].forEach(c => {
    c.classList.remove('is-active');
    c.setAttribute('aria-hidden', 'true');
    track.prepend(c);
  });
  [cloneEnd1, cloneEnd2].forEach(c => {
    c.classList.remove('is-active');
    c.setAttribute('aria-hidden', 'true');
    track.append(c);
  });

  // all slides including clones
  const allSlides = Array.from(track.querySelectorAll<HTMLElement>('.carousel-slide'));
  const dots = Array.from(dotsEl.querySelectorAll<HTMLButtonElement>('.dot'));

  // current index within allSlides — start at index 2 (first real slide)
  let current = 2;
  let isJumping = false;

  function isMobile() { return window.innerWidth <= 768; }

  function setActive(index: number) {
    allSlides.forEach((s, i) => {
      const active = i === index;
      s.classList.toggle('is-active', active);
      s.querySelector('a.cta-btn')?.setAttribute('tabindex', active ? '0' : '-1');
    });

    // sync dots to real index
    const realIndex = ((index - 2) % total + total) % total;
    dots.forEach((d, i) => d.classList.toggle('is-active', i === realIndex));
  }

  function getOffset(index: number) {
    const slideWidth = allSlides[0].offsetWidth;
    const viewportWidth = (track.parentElement as HTMLElement).offsetWidth;
    if (isMobile()) {
      return -(index * (slideWidth + GAP));
    }
    return (viewportWidth / 2) - (slideWidth / 2) - (index * (slideWidth + GAP));
  }

  function goTo(index: number, animate = true) {
    if (!animate) {
      // desativar transições no track e em todos os slides
      track.style.transition = 'none';
      allSlides.forEach(s => (s.style.transition = 'none'));
      void track.offsetHeight; // força reflow
    } else {
      track.style.transition = 'transform 0.45s cubic-bezier(0.4, 0, 0.2, 1)';
      allSlides.forEach(s => (s.style.transition = ''));
    }
    current = index;
    setActive(current);
    track.style.transform = `translateX(${getOffset(current)}px)`;
    if (!animate) {
      // reativar transições no próximo frame de render
      requestAnimationFrame(() => {
        allSlides.forEach(s => (s.style.transition = ''));
      });
    }
  }

  // After transition: silently jump to real slide if on a clone
  track.addEventListener('transitionend', (e) => {
    // ignorar eventos em bubbling vindos dos slides filhos
    if (e.target !== track) return;
    if (isJumping) return;
    const len = allSlides.length;

    if (current <= 1) {
      // on leading clone — jump to equivalent real slide
      isJumping = true;
      goTo(current + total, false);
      isJumping = false;
    } else if (current >= len - 2) {
      // on trailing clone — jump to equivalent real slide
      isJumping = true;
      goTo(current - total, false);
      isJumping = false;
    }
  });

  prevBtn.addEventListener('click', () => goTo(current - 1));
  nextBtn.addEventListener('click', () => goTo(current + 1));

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => goTo(i + 2));
  });

  // Touch/swipe
  let startX = 0;
  const viewport = track.parentElement as HTMLElement;
  viewport.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
  viewport.addEventListener('touchend', e => {
    const diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) goTo(diff > 0 ? current + 1 : current - 1);
  });

  window.addEventListener('resize', () => goTo(current, false));

  // init without animation
  goTo(2, false);
</script>

<style>
  .services-header { margin-bottom: 3.5rem; }

  /* ── Carousel shell ── */
  .carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .carousel-viewport {
    flex: 1;
    overflow: hidden;
    padding: 1.5rem 0;
  }

  .carousel-track {
    display: flex;
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  /* ── Slides ── */
  .carousel-slide {
    flex: 0 0 320px;
    max-width: 320px;
    transition: opacity 0.45s ease, transform 0.45s ease, z-index 0s;
    opacity: 0.4;
    transform: scale(0.88);
    pointer-events: none;
    position: relative;
    z-index: 1;
  }

  .carousel-slide.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
    z-index: 2;
  }

  /* ── Card number (MTG style) ── */
  .card-number {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    font-family: 'DM Mono', 'Courier New', monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--terracotta);
    opacity: 0.7;
    user-select: none;
  }

  /* ── Card ── */
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.5rem 2.25rem;
    background: var(--off-white);
    border: 1px solid rgba(28, 36, 56, 0.15);
    border-radius: 12px;
    text-decoration: none;
    height: 500px;
    box-shadow: 0 4px 20px rgba(28, 36, 56, 0.18);
    transition: box-shadow 0.18s ease, transform 0.18s ease;
  }

  .carousel-slide.is-active .service-card:hover {
    box-shadow:
      0 1px 0 rgba(28, 36, 56, 0.08),
      0 3px 0 rgba(28, 36, 56, 0.05),
      0 6px 14px rgba(28, 36, 56, 0.10);
    transform: translateY(3px);
  }

  .service-icon {
    flex: 1;
    width: 100%;
    background-size: 90% 90%;
    background-repeat: no-repeat;
    background-position: center;
    overflow: hidden;
    margin: 0;
    opacity: 0.8;
  }

  .service-name {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--terracotta);
    margin-bottom: 0.875rem;
  }

  .service-desc {
    font-size: 0.85rem;
    color: #000000;
    line-height: 1.7;
    margin-top: 0.25rem;
  }

  /* ── CTA button ── */
  .cta-btn {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.6rem 1.5rem;
    background: var(--navy);
    border: none;
    border-radius: 20px;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s;
    align-self: flex-start;
  }

  .cta-btn:hover {
    background: #2a3550;
    color: #ffffff;
  }

  /* ── Arrows ── */
  .carousel-arrow {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border);
    background: var(--off-white);
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
    z-index: 2;
  }

  .carousel-arrow:hover {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--cream);
  }

  .carousel-arrow:focus-visible {
    outline: 2px solid var(--terracotta);
    outline-offset: 2px;
  }

  /* ── Dots ── */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: none;
    background: var(--light-gray);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }

  .dot.is-active {
    background: var(--terracotta);
    transform: scale(1.3);
  }

  /* ── Monitor vertical (768px–1024px) ── */
  @media (max-width: 1024px) and (min-width: 769px) {
    .carousel-slide {
      flex: 0 0 280px;
      max-width: 280px;
    }

    .service-card {
      min-height: 380px;
      padding: 2rem 1.75rem;
    }

    .service-name { font-size: 1.25rem; }
  }

  /* ── Mobile (<768px) ── */
  @media (max-width: 768px) {
    .services-header { margin-bottom: 2rem; }

    .carousel {
      flex-direction: column;
      gap: 0;
    }

    .carousel-viewport {
      width: 100%;
      padding: 1rem 0;
    }

    .carousel-slide {
      flex: 0 0 80vw;
      max-width: 80vw;
      opacity: 1;
      transform: scale(1);
    }

    .carousel-slide:not(.is-active) {
      opacity: 0;
      pointer-events: none;
    }

    .service-card {
      min-height: unset;
      padding: 2rem 1.75rem;
    }

    .service-name { font-size: 1.2rem; }
    .service-desc { font-size: 0.82rem; }

    .carousel-arrow { display: none; }
    .carousel-dots  { margin-top: 1.25rem; }
  }
</style>

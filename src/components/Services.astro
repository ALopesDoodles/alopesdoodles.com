---
import type { Translations } from '../i18n/translations';

interface Props {
  tr: Translations;
  lang: string;
}

const { tr, lang } = Astro.props;

const services = [
  {
    key: 'miniEu',
    data: tr.services.miniEu,
    icon: `<svg width="44" height="44" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="20" cy="10" r="6"/>
      <path d="M10 36c0-5.523 4.477-10 10-10s10 4.477 10 10"/>
      <path d="M13 27l-2 9M27 27l2 9"/>
    </svg>`,
  },
  {
    key: 'laser',
    data: tr.services.laser,
    icon: `<svg width="44" height="44" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"/>
      <line x1="15.5" y1="15.5" x2="34" y2="34"/>
      <path d="M28 28l4 2-2-4"/>
      <line x1="6" y1="12" x2="2" y2="12"/>
      <line x1="12" y1="6" x2="12" y2="2"/>
      <line x1="7.5" y1="7.5" x2="4.5" y2="4.5"/>
    </svg>`,
  },
  {
    key: 'tabletop',
    data: tr.services.tabletop,
    icon: `<svg width="44" height="44" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="10" y="20" width="20" height="14" rx="1"/>
      <path d="M10 24h20"/>
      <path d="M15 20v-6a5 5 0 0 1 10 0v6"/>
      <path d="M17 14h6"/>
      <path d="M13 34v2M27 34v2"/>
    </svg>`,
  },
  {
    key: 'collectibles',
    data: tr.services.collectibles,
    icon: `<svg width="44" height="44" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="20" cy="11" r="5"/>
      <path d="M14 16c0 3.314 2.686 6 6 6s6-2.686 6-6"/>
      <rect x="12" y="28" width="16" height="4" rx="1"/>
      <line x1="20" y1="22" x2="20" y2="28"/>
    </svg>`,
  },
  {
    key: 'cosplay',
    data: tr.services.cosplay,
    icon: `<svg width="44" height="44" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 16h20l-2 10H12L10 16z"/>
      <path d="M10 16c0-5.523 4.477-10 10-10s10 4.477 10 10"/>
      <path d="M16 26v4M24 26v4"/>
      <line x1="10" y1="30" x2="30" y2="30"/>
    </svg>`,
  },
  {
    key: 'custom',
    data: tr.services.custom,
    icon: `<svg width="44" height="44" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M28 6l2 2-16 16-3 1 1-3L28 6z"/>
      <path d="M24 10l6 6"/>
      <path d="M18 30c0 0-4 2-8 2 0-4 2-8 2-8"/>
      <path d="M14 28l4-4"/>
    </svg>`,
  },
];

const ctaLabel = tr.services.cta;
---

<section class="section services" aria-labelledby="services-heading">
  <div class="container">

    <header class="services-header">
      <p class="label" id="services-heading">{tr.services.heading}</p>
      <h2 class="section-title">{tr.services.subheading}</h2>
    </header>

    <div class="carousel" role="region" aria-label={tr.services.heading}>

      <button class="carousel-arrow carousel-prev" aria-label="Anterior" id="svc-prev">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 4l-6 6 6 6"/>
        </svg>
      </button>

      <div class="carousel-viewport">
        <ul class="carousel-track" id="svc-track">
          {services.map((service, i) => (
            <li class={`carousel-slide${i === 0 ? ' is-active' : ''}`} data-index={i} data-key={service.key}>
              <article class="service-card">
                <span class="service-icon" set:html={service.icon} />
                <h3 class="service-name">{service.data.label}</h3>
                <p class="service-desc">{service.data.description}</p>
                <a
                  class="cta-btn"
                  href={`/${lang}/portfolio?filter=${service.key}`}
                  tabindex={i === 0 ? '0' : '-1'}
                >{ctaLabel}</a>
              </article>
            </li>
          ))}
        </ul>
      </div>

      <button class="carousel-arrow carousel-next" aria-label="Próximo" id="svc-next">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 4l6 6-6 6"/>
        </svg>
      </button>

    </div>

    <div class="carousel-dots" id="svc-dots" aria-hidden="true">
      {services.map((_, i) => (
        <button class={`dot${i === 0 ? ' is-active' : ''}`} data-dot={i} tabindex="-1" />
      ))}
    </div>

  </div>
</section>

<script>
  const track   = document.getElementById('svc-track') as HTMLElement;
  const dotsEl  = document.getElementById('svc-dots') as HTMLElement;
  const prevBtn = document.getElementById('svc-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('svc-next') as HTMLButtonElement;
  const GAP = 24;

  // ── Infinite loop: clone first 2 and last 2 slides ──
  const realSlides = Array.from(track.querySelectorAll<HTMLElement>('.carousel-slide'));
  const total = realSlides.length;

  // prepend clones of last 2
  const cloneStart1 = realSlides[total - 2].cloneNode(true) as HTMLElement;
  const cloneStart2 = realSlides[total - 1].cloneNode(true) as HTMLElement;
  // append clones of first 2
  const cloneEnd1 = realSlides[0].cloneNode(true) as HTMLElement;
  const cloneEnd2 = realSlides[1].cloneNode(true) as HTMLElement;

  [cloneStart1, cloneStart2].forEach(c => {
    c.classList.remove('is-active');
    c.setAttribute('aria-hidden', 'true');
    track.prepend(c);
  });
  [cloneEnd1, cloneEnd2].forEach(c => {
    c.classList.remove('is-active');
    c.setAttribute('aria-hidden', 'true');
    track.append(c);
  });

  // all slides including clones
  const allSlides = Array.from(track.querySelectorAll<HTMLElement>('.carousel-slide'));
  const dots = Array.from(dotsEl.querySelectorAll<HTMLButtonElement>('.dot'));

  // current index within allSlides — start at index 2 (first real slide)
  let current = 2;
  let isJumping = false;

  function isMobile() { return window.innerWidth <= 768; }

  function setActive(index: number) {
    allSlides.forEach((s, i) => {
      const active = i === index;
      s.classList.toggle('is-active', active);
      s.querySelector('a.cta-btn')?.setAttribute('tabindex', active ? '0' : '-1');
    });

    // sync dots to real index
    const realIndex = ((index - 2) % total + total) % total;
    dots.forEach((d, i) => d.classList.toggle('is-active', i === realIndex));
  }

  function getOffset(index: number) {
    const slideWidth = allSlides[0].offsetWidth;
    const viewportWidth = (track.parentElement as HTMLElement).offsetWidth;
    if (isMobile()) {
      return -(index * (slideWidth + GAP));
    }
    return (viewportWidth / 2) - (slideWidth / 2) - (index * (slideWidth + GAP));
  }

  function goTo(index: number, animate = true) {
    if (!animate) {
      track.style.transition = 'none';
    } else {
      track.style.transition = 'transform 0.45s cubic-bezier(0.4, 0, 0.2, 1)';
    }
    current = index;
    setActive(current);
    track.style.transform = `translateX(${getOffset(current)}px)`;
  }

  // After transition: silently jump to real slide if on a clone
  track.addEventListener('transitionend', () => {
    if (isJumping) return;
    const len = allSlides.length;

    if (current <= 1) {
      // on leading clone — jump to equivalent real slide
      isJumping = true;
      goTo(current + total, false);
      isJumping = false;
    } else if (current >= len - 2) {
      // on trailing clone — jump to equivalent real slide
      isJumping = true;
      goTo(current - total, false);
      isJumping = false;
    }
  });

  prevBtn.addEventListener('click', () => goTo(current - 1));
  nextBtn.addEventListener('click', () => goTo(current + 1));

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => goTo(i + 2));
  });

  // Touch/swipe
  let startX = 0;
  const viewport = track.parentElement as HTMLElement;
  viewport.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
  viewport.addEventListener('touchend', e => {
    const diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) goTo(diff > 0 ? current + 1 : current - 1);
  });

  window.addEventListener('resize', () => goTo(current, false));

  // init without animation
  goTo(2, false);
</script>

<style>
  .services-header { margin-bottom: 3.5rem; }

  /* ── Carousel shell ── */
  .carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .carousel-viewport {
    flex: 1;
    overflow: hidden;
    padding: 1.5rem 0;
  }

  .carousel-track {
    display: flex;
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  /* ── Slides ── */
  .carousel-slide {
    flex: 0 0 320px;
    max-width: 320px;
    transition: opacity 0.45s ease, transform 0.45s ease, z-index 0s;
    opacity: 0.4;
    transform: scale(0.88);
    pointer-events: none;
    position: relative;
    z-index: 1;
  }

  .carousel-slide.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
    z-index: 2;
  }

  /* ── Card ── */
  .service-card {
    display: flex;
    flex-direction: column;
    padding: 2.5rem 2.25rem;
    background: var(--navy);
    border: 1px solid var(--terracotta);
    border-radius: 12px;
    text-decoration: none;
    min-height: 420px;
    transition: background 0.2s, border-color 0.2s;
  }

  .carousel-slide.is-active .service-card:hover {
    background: #243050;
    border-color: #d9622f;
  }

  .service-icon {
    color: var(--cream);
    opacity: 0.9;
    display: block;
    margin-bottom: 2rem;
  }

  .service-name {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--terracotta);
    margin-bottom: 0.875rem;
  }

  .service-desc {
    font-size: 0.85rem;
    color: rgba(232, 212, 176, 0.75);
    line-height: 1.7;
    flex: 1;
  }

  /* ── CTA button ── */
  .cta-btn {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.6rem 1.5rem;
    background: var(--terracotta);
    border: 1px solid rgba(232, 212, 176, 0.4);
    border-radius: 20px;
    color: var(--cream);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s, color 0.2s;
    align-self: flex-start;
  }

  .cta-btn:hover {
    background: #b84a25;
    color: var(--cream);
  }

  /* ── Arrows ── */
  .carousel-arrow {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border);
    background: var(--off-white);
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
    z-index: 2;
  }

  .carousel-arrow:hover {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--cream);
  }

  .carousel-arrow:focus-visible {
    outline: 2px solid var(--terracotta);
    outline-offset: 2px;
  }

  /* ── Dots ── */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: none;
    background: var(--light-gray);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }

  .dot.is-active {
    background: var(--terracotta);
    transform: scale(1.3);
  }

  /* ── Monitor vertical (768px–1024px) ── */
  @media (max-width: 1024px) and (min-width: 769px) {
    .carousel-slide {
      flex: 0 0 280px;
      max-width: 280px;
    }

    .service-card {
      min-height: 380px;
      padding: 2rem 1.75rem;
    }

    .service-name { font-size: 1.25rem; }
  }

  /* ── Mobile (<768px) ── */
  @media (max-width: 768px) {
    .services-header { margin-bottom: 2rem; }

    .carousel {
      flex-direction: column;
      gap: 0;
    }

    .carousel-viewport {
      width: 100%;
      padding: 1rem 0;
    }

    .carousel-slide {
      flex: 0 0 80vw;
      max-width: 80vw;
      opacity: 1;
      transform: scale(1);
    }

    .carousel-slide:not(.is-active) {
      opacity: 0;
      pointer-events: none;
    }

    .service-card {
      min-height: unset;
      padding: 2rem 1.75rem;
    }

    .service-name { font-size: 1.2rem; }
    .service-desc { font-size: 0.82rem; }

    .carousel-arrow { display: none; }
    .carousel-dots  { margin-top: 1.25rem; }
  }
</style>

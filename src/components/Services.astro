---
import type { Translations } from '../i18n/translations';

interface Props {
  tr: Translations;
  lang: string;
}

const { tr } = Astro.props;

const services = [
  {
    key: 'miniEu',
    number: '01',
    data: tr.services.miniEu,
    icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="20" cy="10" r="6"/>
      <path d="M10 36c0-5.523 4.477-10 10-10s10 4.477 10 10"/>
      <path d="M13 27l-2 9M27 27l2 9"/>
    </svg>`,
  },
  {
    key: 'laser',
    number: '02',
    data: tr.services.laser,
    icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"/>
      <line x1="15.5" y1="15.5" x2="34" y2="34"/>
      <path d="M28 28l4 2-2-4"/>
      <line x1="6" y1="12" x2="2" y2="12"/>
      <line x1="12" y1="6" x2="12" y2="2"/>
      <line x1="7.5" y1="7.5" x2="4.5" y2="4.5"/>
    </svg>`,
  },
  {
    key: 'tabletop',
    number: '03',
    data: tr.services.tabletop,
    icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="10" y="20" width="20" height="14" rx="1"/>
      <path d="M10 24h20"/>
      <path d="M15 20v-6a5 5 0 0 1 10 0v6"/>
      <path d="M17 14h6"/>
      <path d="M13 34v2M27 34v2"/>
    </svg>`,
  },
  {
    key: 'collectibles',
    number: '04',
    data: tr.services.collectibles,
    icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="20" cy="11" r="5"/>
      <path d="M14 16c0 3.314 2.686 6 6 6s6-2.686 6-6"/>
      <rect x="12" y="28" width="16" height="4" rx="1"/>
      <line x1="20" y1="22" x2="20" y2="28"/>
    </svg>`,
  },
  {
    key: 'cosplay',
    number: '05',
    data: tr.services.cosplay,
    icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 16h20l-2 10H12L10 16z"/>
      <path d="M10 16c0-5.523 4.477-10 10-10s10 4.477 10 10"/>
      <path d="M16 26v4M24 26v4"/>
      <line x1="10" y1="30" x2="30" y2="30"/>
    </svg>`,
  },
  {
    key: 'custom',
    number: '06',
    data: tr.services.custom,
    icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M28 6l2 2-16 16-3 1 1-3L28 6z"/>
      <path d="M24 10l6 6"/>
      <path d="M18 30c0 0-4 2-8 2 0-4 2-8 2-8"/>
      <path d="M14 28l4-4"/>
    </svg>`,
  },
];
---

<section class="section services" aria-labelledby="services-heading">
  <div class="container">

    <header class="services-header">
      <p class="label" id="services-heading">{tr.services.heading}</p>
      <h2 class="section-title">{tr.services.subheading}</h2>
    </header>

    <div class="services-grid" role="list">
      {services.map(service => (
        <article class="service-card" role="listitem">
          <p class="service-number" aria-hidden="true">{service.number}</p>
          <div class="service-icon" set:html={service.icon} />
          <h3 class="service-name">{service.data.label}</h3>
          <p class="service-desc">{service.data.description}</p>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .services-header { margin-bottom: 3.5rem; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--off-white);
    border: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  /* Últimos 2 cards centrados na segunda linha — apenas desktop */
  @media (min-width: 769px) {
    .services-grid:has(.service-card:nth-child(5):last-child) {
      grid-template-columns: repeat(6, 1fr);
    }
    .services-grid:has(.service-card:nth-child(5):last-child) .service-card:nth-child(1) { grid-column: 1 / 3; }
    .services-grid:has(.service-card:nth-child(5):last-child) .service-card:nth-child(2) { grid-column: 3 / 5; }
    .services-grid:has(.service-card:nth-child(5):last-child) .service-card:nth-child(3) { grid-column: 5 / 7; }
    .services-grid:has(.service-card:nth-child(5):last-child) .service-card:nth-child(4) { grid-column: 2 / 4; grid-row: 2; }
    .services-grid:has(.service-card:nth-child(5):last-child) .service-card:nth-child(5) { grid-column: 4 / 6; grid-row: 2; }
  }

  .service-card {
    background: var(--off-white);
    padding: 3rem 2.5rem;
    transition: background 0.2s;
  }
  .service-card:hover { background: #fff; }

  .service-number {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--terracotta);
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .service-icon {
    color: var(--navy);
    margin-bottom: 1.5rem;
    opacity: 0.85;
  }

  .service-name {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--navy);
    margin-bottom: 0.875rem;
  }

  .service-desc {
    font-size: 0.88rem;
    color: var(--gray);
    line-height: 1.75;
  }

  .services-cta {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 768px) {
    .services        { padding-top: 2rem; }
    .services-grid   { grid-template-columns: 1fr; }
    .services-cta    { justify-content: center; }
    .service-card    { padding: 2rem 1.5rem; }
    .services-header { margin-bottom: 2rem; }
  }
</style>

---
import '../styles/global.css';

interface Props {
  title:       string;
  description: string;
  lang?:       string;
  canonicalPath?: string; // ex: '/pt/portfolio'
  ogImage?:    string;
}

const {
  title,
  description,
  lang         = 'pt',
  canonicalPath,
  ogImage      = '/gallery/alopesdoodles-logo.png',
} = Astro.props;

const siteUrl   = 'https://alopesdoodles.com';
const canonical = canonicalPath ? `${siteUrl}${canonicalPath}` : `${siteUrl}${Astro.url.pathname}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const localeMap: Record<string, string> = { pt: 'pt_PT', es: 'es_ES', en: 'en_US' };
const ogLocale = localeMap[lang] ?? 'pt_PT';

// JSON-LD — LocalBusiness schema
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'A.Lopes Doodles',
  description: 'Impressão 3D, Gravação Laser e Pintura. Trabalhos elaborados por quem ama o que faz.',
  url: siteUrl,
  image: ogImageUrl,
  logo: ogImageUrl,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'PT',
  },
  sameAs: [
    'https://www.instagram.com/a.lopesdoodlesworkshop',
    'https://www.facebook.com/share/1Hsz5mHw4U/',
  ],
  telephone: '+351912553507',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+351912553507',
    contactType: 'customer service',
    availableLanguage: ['Portuguese', 'Spanish', 'English'],
  },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO primário -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp, etc.) -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="A.Lopes Doodles" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:image"       content={ogImageUrl} />
    <meta property="og:locale"      content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Umami Analytics -->
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="080c854f-2e40-4f3e-bd55-a0a35ac8e48c"></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar para o conteúdo principal</a>
    <slot />
    <button class="back-to-top" id="back-to-top" aria-label="Voltar ao topo">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>

    <a
      href="https://wa.me/351912553507"
      class="wa-float"
      target="_blank"
      rel="noopener"
      aria-label="Contactar via WhatsApp"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
    </a>
  </body>

  <style>
    .wa-float {
      position: fixed;
      bottom: 1.75rem;
      right: 1.75rem;
      z-index: 999;
      background: #25d366;
      color: #fff;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(0,0,0,0.18);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .wa-float:hover {
      transform: scale(1.08);
      box-shadow: 0 6px 24px rgba(0,0,0,0.24);
    }
    @media (max-width: 768px) {
      .wa-float {
        width: 40px;
        height: 40px;
        bottom: 1rem;
        right: 1rem;
      }
    }

  </style>

  <script>
    const btn    = document.getElementById('back-to-top');
    const wa     = document.querySelector('.wa-float') as HTMLElement | null;
    const footer = document.querySelector('.site-footer') as HTMLElement | null;

    function update() {
      const mobile  = window.innerWidth <= 768;
      const BASE    = mobile ? 16 : 1.75 * 16;
      const WA_H    = mobile ? 40 : 52;
      const GAP     = mobile ? 10 : 12;

      const overlap = footer
        ? Math.max(0, window.innerHeight - footer.getBoundingClientRect().top - BASE)
        : 0;
      const waBottom  = BASE + overlap;
      const btnBottom = waBottom + WA_H + GAP;

      if (wa)  wa.style.bottom  = waBottom  + 'px';
      if (btn) (btn as HTMLElement).style.bottom = btnBottom + 'px';

      btn?.classList.toggle('visible', window.scrollY > 300);
    }


    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();

    btn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</html>

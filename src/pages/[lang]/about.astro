---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'pt' } },
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const tr = t(lang);
const a = tr.about;
---

<Layout lang={lang} title={tr.seo.about.title} description={tr.seo.about.description} canonicalPath={`/${lang}/about`}>
  <Header lang={lang} currentPage="about" tr={tr} />
  <main id="main-content" tabindex="-1">

    <section class="section page-hero">
      <div class="container">
        <p class="label">{a.label}</p>
        <h1 class="section-title">{a.heading}</h1>
        <p class="page-subtitle">{a.subtitle}</p>
      </div>
    </section>
    <hr class="divider" />

    <section class="section about-section">
      <div class="container about-grid">

        <!-- Photo -->
        <div class="about-photo-wrap">
          <img src="/gallery/Alopes%20Foto.png" alt="António Lopes" class="about-photo" />
          <div class="about-origin">
            <span class="label">{a.location}</span>
          </div>
        </div>

        <!-- Text content -->
        <div class="about-content">
          <h2 class="about-name">António Lopes</h2>
          <p class="about-body">{a.body1}</p>
          <p class="about-body">{a.body2}</p>
          <p class="about-body">{a.body3}</p>

          <a href={`/${lang}/contact`} class="btn btn-primary">{tr.nav.contact}</a>
        </div>

      </div>
    </section>

  </main>
  <Footer tr={tr} lang={lang} />
</Layout>

<style>
  .page-hero { padding-bottom: 3rem; }
  .page-hero .label { margin-bottom: 0.75rem; }
  .page-subtitle {
    margin-top: 0.75rem;
    font-size: 1rem;
    color: var(--gray);
    font-style: italic;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 6rem;
    align-items: start;
  }

  /* Photo */
  .about-photo-wrap { position: relative; }

  .about-photo {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }

  .about-origin {
    margin-top: 1.25rem;
  }

  /* Content */
  .about-name {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    color: var(--navy);
    margin-bottom: 2rem;
  }

  .about-body {
    font-size: 0.95rem;
    color: var(--gray);
    line-height: 1.85;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .about-photo { aspect-ratio: 4/3; }
  }
</style>

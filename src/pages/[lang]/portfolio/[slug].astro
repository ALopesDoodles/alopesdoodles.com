---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { t } from '../../../i18n/translations';
import { portfolioItems } from '../../../data/portfolio';

export function getStaticPaths() {
  return portfolioItems.flatMap(item =>
    ['pt', 'es', 'en'].map(lang => ({
      params: { lang, slug: item.slug },
      props: { item },
    }))
  );
}

const { lang, slug } = Astro.params;
const { item } = Astro.props;
const tr = t(lang);

const categoryLabel = tr.portfolio.filter[item.category as keyof typeof tr.portfolio.filter] ?? item.category;
---

<Layout
  lang={lang}
  title={`${item.title} — A.Lopes Doodles`}
  description={item.alt ?? item.title}
  canonicalPath={`/${lang}/portfolio/${slug}`}
>
  <Header lang={lang} currentPage="portfolio" tr={tr} />

  <main id="main-content" tabindex="-1">

    <!-- Hero do trabalho -->
    <section class="section work-hero">
      <div class="container">
        <a href={`/${lang}/portfolio`} class="back-link">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 3L5 8l5 5"/>
          </svg>
          {tr.portfolio.heading}
        </a>
        <div class="work-meta">
          <span class="category-badge">{categoryLabel}</span>
        </div>
        <h1 class="work-title">{item.title}</h1>
      </div>
    </section>

    <hr class="divider" />

    <section class="section work-body">
      <div class="container">

        <!-- Resultado Final -->
        <div class="work-section">
          <h2 class="work-section-label">Resultado Final</h2>
          <div class="result-wrap">
            {item.src ? (
              <button class="lb-trigger" data-src={item.src} data-alt={item.alt!} aria-label={`Ampliar: ${item.alt}`}>
                <img src={item.src} alt={item.alt!} class="result-img" />
              </button>
            ) : (
              <div class="placeholder-hero">
                <span class="placeholder-text">Fotografia em breve</span>
              </div>
            )}
          </div>
        </div>

        <!-- Processo de Criação -->
        <div class="work-section">
          <h2 class="work-section-label">Processo de Criação</h2>
          <p class="work-section-sub">Modelação 3D, impressão e detalhes de pintura</p>
          <div class="process-grid">
            {['Modelação 3D', 'Impressão', 'Lixagem e preparação', 'Pintura base'].map(step => (
              <div class="process-card">
                <div class="process-img-placeholder">
                  <span class="placeholder-text">Em breve</span>
                </div>
                <p class="process-label">{step}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Fotografias -->
        <div class="work-section">
          <h2 class="work-section-label">Fotografias</h2>
          <p class="work-section-sub">Imagens do resultado final em detalhe</p>
          <div class="photos-grid">
            {[1, 2, 3].map(() => (
              <div class="photo-placeholder">
                <span class="placeholder-text">Em breve</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Imagem ampliada" hidden>
    <button class="lightbox-close" id="lightbox-close" aria-label="Fechar">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M2 2l18 18M20 2L2 20"/>
      </svg>
    </button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
  </div>

  <Footer tr={tr} lang={lang} />
<script>
  const lightbox    = document.getElementById('lightbox') as HTMLElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn    = document.getElementById('lightbox-close') as HTMLButtonElement;

  function open(src: string, alt: string) {
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function close() {
    lightbox.hidden = true;
    document.body.style.overflow = '';
    lightboxImg.src = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.lb-trigger').forEach(btn => {
    btn.addEventListener('click', () => open(btn.dataset.src ?? '', btn.dataset.alt ?? ''));
  });

  closeBtn.addEventListener('click', close);
  lightbox.addEventListener('click', e => { if (e.target === lightbox) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !lightbox.hidden) close(); });
</script>

</Layout>

<style>
  /* ── Hero ── */
  .work-hero { padding-bottom: 2.5rem; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gray);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--navy); }

  .work-meta { margin-bottom: 0.75rem; }

  .category-badge {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    background: var(--terracotta);
    color: var(--off-white);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 20px;
  }

  .work-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: var(--navy);
    line-height: 1.15;
    margin: 0;
  }

  /* ── Body ── */
  .work-body { padding-top: 3rem; }

  .work-section {
    margin-bottom: 4rem;
  }

  .work-section-label {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--navy);
    margin-bottom: 0.35rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(28, 36, 56, 0.12);
  }

  .work-section-sub {
    font-size: 0.82rem;
    color: var(--gray);
    margin-bottom: 1.5rem;
    margin-top: 0.35rem;
  }

  /* ── Resultado final ── */
  .result-wrap {
    max-width: 480px;
  }

  .result-img {
    width: 100%;
    border-radius: 12px;
    display: block;
    box-shadow: 0 4px 24px rgba(28, 36, 56, 0.12);
  }

  .placeholder-hero {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 3 / 4;
    border: 2px dashed rgba(196, 83, 42, 0.35);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Processo ── */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .process-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .process-img-placeholder {
    aspect-ratio: 1 / 1;
    border: 2px dashed rgba(196, 83, 42, 0.35);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .process-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--gray);
    text-align: center;
  }

  /* ── Fotografias ── */
  .photos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .photo-placeholder {
    aspect-ratio: 4 / 3;
    border: 2px dashed rgba(196, 83, 42, 0.35);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Result image trigger ── */
  .lb-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: zoom-in;
    display: block;
    width: 100%;
  }

  .lb-trigger:focus-visible {
    outline: 2px solid var(--terracotta);
    outline-offset: 3px;
    border-radius: 12px;
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(10, 12, 20, 0.92);
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .lightbox[hidden] { display: none; }

  .lightbox-img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 8px 48px rgba(0,0,0,0.5);
  }

  .lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 0.5rem;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .lightbox-close:hover { opacity: 1; }

  /* ── Placeholder text ── */
  .placeholder-text {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terracotta);
    opacity: 0.6;
  }

  /* ── Monitor vertical (768–1024px) ── */
  @media (max-width: 1024px) and (min-width: 769px) {
    .process-grid { grid-template-columns: repeat(2, 1fr); }
    .photos-grid  { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Mobile (<768px) ── */
  @media (max-width: 768px) {
    .work-title { font-size: 1.75rem; }
    .process-grid { grid-template-columns: repeat(2, 1fr); }
    .photos-grid  { grid-template-columns: repeat(1, 1fr); }
    .result-wrap  { max-width: 100%; }
  }
</style>

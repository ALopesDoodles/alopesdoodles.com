---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { t } from '../../../i18n/translations';
import { getGalleryItems } from '../../../data/gallery';

export function getStaticPaths() {
  const items = getGalleryItems();
  return items.flatMap(item =>
    ['pt', 'es', 'en'].map(lang => ({
      params: { lang, slug: item.slug },
      props: { item },
    }))
  );
}

const { lang, slug } = Astro.params;
const { item } = Astro.props;
const tr = t(lang);

const categoryLabel = tr.portfolio.filter[item.category as keyof typeof tr.portfolio.filter] ?? item.category;

const categoryAltMap: Record<string, string> = {
  miniEu:       'Figura mini-eu estilo Funko impressa em resina 3D',
  collectibles: 'Estatueta colecionável impressa em resina 3D',
  laser:        'Gravação laser personalizada',
  tabletop:     'Miniatura tabletop',
  cosplay:      'Peça cosplay impressa em 3D',
  custom:       'Peça customizável',
};
const categoryAlt = categoryAltMap[item.category] ?? categoryLabel;

const detailTitle = `${categoryLabel} #${item.num} — A.Lopes Doodles`;

const detailDescriptions: Record<string, string> = {
  pt: `${categoryLabel} feito à mão em Portugal. Vê o processo de criação e o resultado final — cada peça é única.`,
  es: `${categoryLabel} hecho a mano en Portugal. Ve el proceso de creación y el resultado final — cada pieza es única.`,
  en: `${categoryLabel} handmade in Portugal. See the creation process and the final result — every piece is unique.`,
};
const detailDescription = detailDescriptions[lang] ?? detailDescriptions['pt'];
---

<Layout
  lang={lang}
  title={detailTitle}
  description={detailDescription}
  canonicalPath={`/${lang}/portfolio/${slug}`}
>
  <Header lang={lang} currentPage="portfolio" tr={tr} />

  <main id="main-content" tabindex="-1">

    <section class="section work-hero">
      <div class="container">
        <a href={`/${lang}/portfolio`} class="back-link">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 3L5 8l5 5"/>
          </svg>
          {tr.portfolio.heading}
        </a>
        <div class="work-meta">
          <h1 class="work-title">{categoryLabel} <span class="work-num">#{item.num}</span></h1>
          <span class="category-badge">{categoryLabel}</span>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="section work-body">
      <div class="container">

        <!-- Resultado Final -->
        <div class="work-section">
          <h2 class="work-section-label">Resultado Final</h2>
          <div class="result-wrap">
            <button class="lb-trigger" data-src={item.display} data-alt={categoryAlt} aria-label={`Ampliar: ${categoryAlt}`}>
              <img src={item.display} alt={categoryAlt} class="result-img" />
            </button>
          </div>
        </div>

        <!-- Processo de Criação -->
        {item.process.length > 0 && (
          <div class="work-section">
            <h2 class="work-section-label">Processo de Criação</h2>
            <div class="process-grid">
              {item.process.map((src, i) => (
                <button class="lb-trigger process-trigger" data-src={src} data-alt={`${categoryAlt} — processo ${i + 1}`} aria-label={`Ampliar processo ${i + 1}`}>
                  <img src={src} alt={`${categoryAlt} — processo ${i + 1}`} class="process-img" loading="lazy" />
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Fotografias -->
        {item.final.length > 0 && (
          <div class="work-section">
            <h2 class="work-section-label">Fotografias</h2>
            <div class="photos-grid">
              {item.final.map((src, i) => (
                <button class="lb-trigger photo-trigger" data-src={src} data-alt={`${categoryAlt} — fotografia ${i + 1}`} aria-label={`Ampliar fotografia ${i + 1}`}>
                  <img src={src} alt={`${categoryAlt} — fotografia ${i + 1}`} class="photo-img" loading="lazy" />
                </button>
              ))}
            </div>
          </div>
        )}

      </div>
    </section>

  </main>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Imagem ampliada" hidden>
    <button class="lightbox-close" id="lightbox-close" aria-label="Fechar">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M2 2l18 18M20 2L2 20"/>
      </svg>
    </button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
  </div>

  <Footer tr={tr} lang={lang} />

<script>
  const lightbox    = document.getElementById('lightbox') as HTMLElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn    = document.getElementById('lightbox-close') as HTMLButtonElement;

  function open(src: string, alt: string) {
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function close() {
    lightbox.hidden = true;
    document.body.style.overflow = '';
    lightboxImg.src = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.lb-trigger').forEach(btn => {
    btn.addEventListener('click', () => open(btn.dataset.src ?? '', btn.dataset.alt ?? ''));
  });

  closeBtn.addEventListener('click', close);
  lightbox.addEventListener('click', e => { if (e.target === lightbox) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !lightbox.hidden) close(); });
</script>

</Layout>

<style>
  .work-hero { padding-bottom: 2.5rem; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gray);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--navy); }

  .work-meta { margin-bottom: 0.75rem; }

  .work-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    color: var(--navy);
    margin-bottom: 0.75rem;
  }
  .work-num {
    color: var(--terracotta);
    font-size: 0.85em;
  }

  .category-badge {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    background: var(--terracotta);
    color: var(--off-white);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 20px;
  }

  .work-body { padding-top: 3rem; }

  .work-section { margin-bottom: 4rem; }

  .work-section-label {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--navy);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(28, 36, 56, 0.12);
  }

  /* Resultado Final */
  .result-wrap { max-width: 480px; }

  .result-img {
    width: 100%;
    border-radius: 12px;
    display: block;
    box-shadow: 0 4px 24px rgba(28, 36, 56, 0.12);
  }

  /* Processo */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  .process-trigger { border-radius: 10px; }

  .process-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 10px;
    display: block;
    box-shadow: 0 2px 12px rgba(28, 36, 56, 0.1);
    transition: transform 0.2s ease;
  }
  .process-trigger:hover .process-img { transform: scale(1.02); }

  /* Fotografias */
  .photos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .photo-trigger { border-radius: 10px; }

  .photo-img {
    width: 100%;
    border-radius: 10px;
    display: block;
    box-shadow: 0 2px 12px rgba(28, 36, 56, 0.1);
    transition: transform 0.2s ease;
  }
  .photo-trigger:hover .photo-img { transform: scale(1.02); }

  /* Triggers */
  .lb-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: zoom-in;
    display: block;
    width: 100%;
  }
  .lb-trigger:focus-visible {
    outline: 2px solid var(--terracotta);
    outline-offset: 3px;
    border-radius: 12px;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(10, 12, 20, 0.92);
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .lightbox[hidden] { display: none; }

  .lightbox-img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 8px 48px rgba(0,0,0,0.5);
  }

  .lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 0.5rem;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .lightbox-close:hover { opacity: 1; }

  @media (max-width: 1024px) and (min-width: 769px) {
    .photos-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .result-wrap  { max-width: 100%; }
    .process-grid { grid-template-columns: repeat(2, 1fr); }
    .photos-grid  { grid-template-columns: repeat(2, 1fr); }
  }
</style>
